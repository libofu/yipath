# Copy to .env.production (never commit that file) and fill in the values.
YIPATH_ENV=production

# AI provider for the readings. Use one: deepseek or anthropic.
YIPATH_LLM=deepseek
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# YIPATH_MODEL=deepseek-flash

# Must equal the iOS bundle id.
YIPATH_APPLE_BUNDLE_ID=com.libofu.yipath

# Free days from signup before a subscription is required.
YIPATH_TRIAL_DAYS=3

# Only change if you rename the subscription products in App Store Connect:
# YIPATH_PRODUCT_IDS=com.libofu.yipath.monthly,com.libofu.yipath.yearly
