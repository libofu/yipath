ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# YIPATH_MODEL=deepseek-flash

# "production" disables the anonymous dev signup and never honours YIPATH_STOREKIT_LOCAL
# YIPATH_ENV=production
# Free days from signup before a subscription is required (default 3)
# YIPATH_TRIAL_DAYS=3
# Accept Xcode local-StoreKit test purchases (dev only)
# YIPATH_STOREKIT_LOCAL=1
# Must equal the iOS bundle id (default com.libofu.yipath)
# YIPATH_APPLE_BUNDLE_ID=com.libofu.yipath
